  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ljaspNotch reads what Spotify and Music are playing and sends play, pause, next and seek commands to them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ljaspNotch, Spotify ve Müzik'te ne çaldığını okur ve onlara oynat, duraklat, sonraki ve sarma komutları gönderir."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ljaspNotch shows your upcoming events in the notch. Nothing leaves your Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ljaspNotch yaklaşan etkinliklerinizi notch'ta gösterir. Hiçbir veri Mac'inizden çıkmaz."
          }
        }
      }
    }
  },
  "version" : "1.0"
