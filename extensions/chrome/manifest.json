{
  "manifest_version": 3,
  "name": "ljaspNotch",
  "description": "Shows YouTube and YouTube Music in the ljaspNotch notch app and controls playback from it.",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
