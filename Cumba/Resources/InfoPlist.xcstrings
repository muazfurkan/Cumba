{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cumba reads what Spotify and Music are playing and sends play, pause, next and seek commands to them, and shows your recent Apple Notes and makes new ones."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba, Spotify ve Müzik'te çalanı okur ve onlara oynat, duraklat, sonraki ve sarma komutlarını gönderir; ayrıca son Apple Notlar'ınızı gösterir ve yeni not oluşturur."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cumba shows your upcoming events in the notch. Nothing leaves your Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba yaklaşan etkinliklerinizi notch'ta gösterir. Hiçbir veri Mac'inizden çıkmaz."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Mirror widget shows your camera while the panel is open. Nothing is recorded or sent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayna widget'ı panel açıkken kameranızı gösterir. Hiçbir şey kaydedilmez veya gönderilmez."
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription" : {
      "comment" : "Privacy - Desktop Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Clipboard History widget shows new screenshots saved to your Desktop, and the Tray widget shows files you put on it. Nothing leaves your Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pano Geçmişi widget'ı Masaüstü'ne kaydedilen yeni ekran görüntülerini, Raf widget'ı da üzerine bıraktığınız dosyaları gösterir. Hiçbir şey Mac'inizden çıkmaz."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription" : {
      "comment" : "Privacy - Documents Folder Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Tray widget shows the files you put on it. Nothing leaves your Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raf widget'ı üzerine bıraktığınız dosyaları gösterir. Hiçbir şey Mac'inizden çıkmaz."
          }
        }
      }
    },
