{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cumba reads what Spotify and Music are playing and sends play, pause, next and seek commands to them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba, Spotify ve Müzik'te ne çaldığını okur ve onlara oynat, duraklat, sonraki ve sarma komutları gönderir."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cumba shows your upcoming events in the notch. Nothing leaves your Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cumba yaklaşan etkinliklerinizi notch'ta gösterir. Hiçbir veri Mac'inizden çıkmaz."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Mirror widget shows your camera while the panel is open. Nothing is recorded or sent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayna widget'ı panel açıkken kameranızı gösterir. Hiçbir şey kaydedilmez veya gönderilmez."
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Weather widget shows the weather where you are. Your location is rounded to about 10 km first."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava Durumu widget'ı bulunduğunuz yerin havasını gösterir. Konumunuz önce yaklaşık 10 km'ye yuvarlanır."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Weather widget shows the weather where you are. Your location is rounded to about 10 km first."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hava Durumu widget'ı bulunduğunuz yerin havasını gösterir. Konumunuz önce yaklaşık 10 km'ye yuvarlanır."
          }
