    },
    "1. Open chrome://extensions and turn on Developer mode.\n2. Click “Load unpacked” and choose the extension folder.\n3. Open the extension's options and paste the port and the token." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. chrome://extensions adresini açın ve Geliştirici modunu etkinleştirin.\n2. “Paketlenmemiş öğe yükle”ye tıklayın ve eklenti klasörünü seçin.\n3. Eklentinin seçeneklerini açın, portu ve token'ı yapıştırın."
          }
        }
      }
    },
    "A backup of the current file is made before saving." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetmeden önce mevcut dosyanın yedeği alınır."
